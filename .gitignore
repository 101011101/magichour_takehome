.DS_Store
__pycache__/
.env
.venv/
image-files/
judging_sheet.csv

# V1 run outputs stay out of the repo
/runs/
v1/build/
v1/runs/

# --- V2 run outputs -----------------------------------------------------------
# Generated images are NOT tracked: ~190MB, and regenerable from the code and the
# manifests below. Model weights are not tracked either (~610MB, all re-download).
# What IS tracked is the metadata needed to know what was run and to re-run it.
v2/runs/*

# manifests: which pairs, which arms, which reference produced which output, and
# every gate score. Small, and the human labels at repo root are keyed to them.
!v2/runs/amt/
v2/runs/amt/*
!v2/runs/amt/*.json

# the path index every script reads to locate source images
!v2/runs/crop_screen/
v2/runs/crop_screen/*
!v2/runs/crop_screen/crop_log.csv

# The built report. 111 MB of downsized generations, regenerable in one command
# from v2/build/report_*.py. Deploy it with `npx vercel deploy v2/report`; keeping
# it out of git avoids permanently publishing try-ons of identifiable people to a
# public repo, which is the repo owner's call rather than a default.
v2/report/
